// SE7 Hub — banco NOVO e exclusivo do sistema unificado.
//
// Regra que vale para o projeto inteiro: esta DATABASE_URL NUNCA aponta para o
// MySQL do sistema Laravel.
//
// O Hub e o sistema de registro da escola: alunos, responsaveis, turmas,
// planos, matriculas e frequencia sao dele, nao mais lidos de outro lugar. O
// domino abaixo foi reconstruido a partir das migrations do se7volei, com os
// defeitos daquele schema corrigidos — ver o bloco "Escola" no fim do arquivo.
//
// O Laravel continua no ar ate a virada. A ponte de leitura em src/db/legacy/
// existe agora para UMA coisa: a importacao unica que traz os dados de la para
// ca. Ela nao alimenta mais nenhuma tela.
//
// As tabelas do Hub ficam no schema `hub`, separadas das do se7-inadimplencia,
// que estao em `public`. E por isso que a tabela `usuarios` daqui nao colide
// com a de la, mesmo os dois dividindo o banco.
//
// O cronograma e a excecao proposital: ele NAO e um modelo do Prisma aqui,
// porque a tabela pertence ao se7-inadimplencia (`public.cronograma_semanas`).
// O Hub le e escreve nela por SQL explicito, em src/db/compartilhado/ — mesmo
// padrao da ponte com o MySQL. Assim ha uma fonte da verdade so, e o schema
// do Hub nunca tem poder de alterar a tabela do outro sistema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// DATABASE_URL = pooler do Supabase (6543), usado pela aplicacao.
// DIRECT_URL   = conexao direta (5432), usada so por `prisma db push`/migrate —
// mudanca de schema nao passa pelo pooler de transacao.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")

  // O Hub divide o Postgres do Supabase com o se7-inadimplencia, cujas tabelas
  // vivem em `public`. Listar apenas "hub" aqui não é organização: é o que
  // impede `prisma db push` de enxergar as tabelas do outro sistema e tentar
  // apagá-las por não estarem neste schema. A regra é estrutural, não
  // disciplinar — não dá para esquecer dela.
  schemas = ["hub"]
}

// ---------------------------------------------------------------------------
// Acesso
//
// Um Usuario e uma PESSOA, nao um perfil. A mesma pessoa pode ser professor e
// responsavel por um filho matriculado ao mesmo tempo — por isso papel e
// vinculo sao tabelas separadas, e nao colunas em Usuario.
// ---------------------------------------------------------------------------

model Usuario {
  id            String    @id @default(uuid())
  nome          String
  email         String    @unique
  avatarUrl     String?
  ativo         Boolean   @default(true)
  ultimoLoginEm DateTime?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  identidades       Identidade[]
  papeis            Papel[]
  vinculos          Vinculo[]
  tentativasVinculo TentativaVinculo[]

  @@map("usuarios")
  @@schema("hub")
}

enum Provedor {
  GOOGLE
  SENHA

  @@schema("hub")
}

// Uma linha por forma de entrar. Google e o caminho normal; SENHA existe so
// para as contas de administracao nao ficarem trancadas do lado de fora se o
// login social falhar (senhaHash em bcrypt, nunca MD5).
model Identidade {
  id          String   @id @default(uuid())
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  provedor    Provedor
  provedorSub String // 'sub' do Google, ou o proprio email quando provedor = SENHA
  senhaHash   String?
  criadoEm    DateTime @default(now())

  @@unique([provedor, provedorSub])
  @@index([usuarioId])
  @@map("identidades")
  @@schema("hub")
}

enum PapelNome {
  // O dono. Faz tudo o que o ADMIN faz, e mais: a area dos socios. Quem contem
  // quem esta em src/plugins/auth.ts, num lugar so — nao repetido rota a rota.
  SOCIO
  ADMIN
  ADMINISTRATIVO
  PROFESSOR
  RESPONSAVEL

  @@schema("hub")
}

model Papel {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome      PapelNome
  criadoEm  DateTime  @default(now())

  @@unique([usuarioId, nome])
  @@map("papeis")
  @@schema("hub")
}

enum TipoVinculo {
  RESPONSAVEL // aponta para customers.id no Laravel
  PROFESSOR // aponta para teachers.id no Laravel

  @@schema("hub")
}

// Liga a conta Google a uma linha real do sistema Laravel. Sem vinculo, o
// usuario esta autenticado mas nao "e" ninguem — nao ve dado de aluno nenhum.
model Vinculo {
  id        String      @id @default(uuid())
  usuarioId String
  usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoVinculo

  // A conta aponta para a pessoa dentro do Hub. Antes isto era um `legacyId`
  // inteiro apontando para uma linha do MySQL do Laravel — o que so fazia
  // sentido enquanto a escola morava la. Agora sao chaves estrangeiras de
  // verdade: nao da para vincular uma conta a um professor que nao existe.
  professorId   String?
  professor     Professor?   @relation(fields: [professorId], references: [id])
  responsavelId String?
  responsavel   Responsavel? @relation(fields: [responsavelId], references: [id])

  cpf          String? // so digitos, so para RESPONSAVEL
  confirmadoEm DateTime @default(now())

  // Uma pessoa pertence a uma conta so. Se duas tentarem reivindicar o mesmo
  // CPF, a segunda e recusada e cai para atendimento.
  @@unique([professorId])
  @@unique([responsavelId])
  @@index([usuarioId])
  @@map("vinculos")
  @@schema("hub")
}

// O vinculo por CPF e o unico ponto do sistema onde alguem autenticado consulta
// a base pelo documento de outra pessoa. Sem registro e limite, isso vira o
// mesmo problema de enumeracao de CPF que existe hoje na API publica do
// Laravel. Toda tentativa entra aqui, com o CPF em hash — o numero em claro
// nunca e gravado nesta tabela.
model TentativaVinculo {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cpfHash   String
  sucesso   Boolean
  ip        String   @default("")
  criadoEm  DateTime @default(now())

  @@index([usuarioId, criadoEm])
  @@map("tentativas_vinculo")
  @@schema("hub")
}

// Professor, administrativo e admin nao entram sozinhos: o acesso e por convite.
// Isso e uma consequencia do schema do Laravel, nao uma escolha de produto — a
// tabela `teachers` nao tem CPF nem email, entao nao ha como o proprio
// professor provar quem e no primeiro acesso.
model Convite {
  id          String    @id @default(uuid())
  email       String    @unique
  papel       PapelNome
  professorId String? // qual professor, quando o convite e para a area do professor
  criadoPorId String?
  expiraEm    DateTime
  usadoEm     DateTime?
  criadoEm    DateTime  @default(now())

  @@index([email])
  @@map("convites")
  @@schema("hub")
}

enum TipoEvento {
  TREINO_ESPECIAL
  CAMPEONATO
  FESTIVAL
  REUNIAO
  AVALIACAO
  FERIADO
  OUTRO

  @@schema("hub")
}

// Eventos do mês: campeonato, festival, aulão, reunião, avaliação, feriado.
// `unidadeIdLegacy` nulo significa "vale para todas as unidades" — é o caso
// mais comum (feriado, campeonato), então nulo é o padrão útil.
model Evento {
  id              String     @id @default(uuid())
  titulo          String
  descricao       String?
  tipo            TipoEvento @default(OUTRO)
  data            DateTime   @db.Date
  dataFim         DateTime?  @db.Date
  horario         String? // "08:00 às 11:00" — texto livre, o horário real varia
  local           String?
  unidadeIdLegacy Int?
  unidadeNome     String?
  publicado       Boolean    @default(false)
  criadoEm        DateTime   @default(now())
  atualizadoEm    DateTime   @updatedAt

  @@index([data, publicado])
  @@map("eventos")
  @@schema("hub")
}

// ---------------------------------------------------------------------------
// Configurações do Hub — pares chave/valor que valem para o sistema todo.
//
// Nasceu do link do Canva: ele é UM documento que rege todas as semanas, não
// um por semana. Guardar por semana obrigava a repetir o mesmo endereço toda
// vez e deixava a pergunta "qual é o certo?" no ar.
// ---------------------------------------------------------------------------

model Configuracao {
  chave        String   @id
  valor        String
  atualizadoEm DateTime @updatedAt

  @@map("configuracoes")
  @@schema("hub")
}

// ---------------------------------------------------------------------------
// Ocorrências — o professor avisa, o administrativo resolve.
//
// Junta numa caixa de entrada só o que hoje se perde no WhatsApp: aluno na
// turma errada, aluno que deveria estar na lista e não está, e o registro do
// que aconteceu no treino. São a mesma coisa do ponto de vista de quem
// resolve — alguém precisa ler, agir e dar baixa —, então um modelo com tipo
// serve melhor que três telas parecidas.
//
// Turma e aluno ficam como texto além do id: quando a ponte com o MySQL
// estiver desligada, o professor ainda precisa conseguir avisar, e a
// administrativo precisa entender o aviso sem consultar outro sistema.
// ---------------------------------------------------------------------------

enum TipoOcorrencia {
  TURMA_ERRADA // aluno está numa turma que não é a dele
  ALUNO_FALTANDO // aluno deveria estar na lista da turma e não está
  REGISTRO_TREINO // o que aconteceu no treino (chuva, material, lesão)
  OUTRO

  @@schema("hub")
}

enum StatusOcorrencia {
  ABERTA
  RESOLVIDA

  @@schema("hub")
}

model Ocorrencia {
  id     String           @id @default(uuid())
  tipo   TipoOcorrencia
  status StatusOcorrencia @default(ABERTA)

  // Quem avisou. O nome e o da turma ficam gravados junto da chave: o aviso
  // precisa continuar legível daqui a um ano, mesmo que a turma seja
  // renomeada ou o professor saia da escola.
  professorId   String
  professor     Professor @relation(fields: [professorId], references: [id])
  professorNome String

  turmaId   String?
  turma     Turma?  @relation(fields: [turmaId], references: [id])
  turmaNome String?
  alunoNome String?

  descricao String

  // A resposta do administrativo fecha o ciclo: o professor vê o que foi feito.
  resposta       String?
  resolvidoPorId String?
  resolvidoEm    DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status, criadoEm])
  @@index([professorId, criadoEm])
  @@map("ocorrencias")
  @@schema("hub")
}

// ===========================================================================
// Escola — o domínio reconstruído a partir do sistema Laravel
// ===========================================================================
//
// Estes modelos são a tradução das migrations do se7volei (units, courses,
// course_schedules, students, customers, teachers, plans, enrollments,
// attendances e os pivôs course_plan e course_teacher). O Hub deixa de ler a
// escola do MySQL e passa a ser dono dela.
//
// Não é cópia: é o mesmo domínio com os defeitos do original corrigidos.
// O que mudou, e por quê:
//
//   - `students.customer_id` era um `integer` solto, sem chave estrangeira.
//     Dava para gravar um aluno apontando para um responsável inexistente.
//     Agora é relação de verdade.
//   - `courses.teachers` era um longText com os professores repetidos ao lado
//     do pivô `course_teacher`. Duas fontes para o mesmo fato, que divergem
//     sozinhas. Ficou só o pivô.
//   - `courses.amount_students` (capacidade da turma) era `text`. Virou `Int`.
//   - `customers.address_number` foi criado NOT NULL sem default, numa tabela
//     que já tinha linhas. Aqui é opcional, como todo o resto do endereço.
//   - O enum de status trazia PAYMENT_PENDDING, com dois D. O erro de digitação
//     está no banco de produção desde 2023 e vazava para a tela. Aqui os nomes
//     estão em português e corretos; a importação faz o de-para.
//   - `students`, `customers` e `enrollments` tinham `deleted_at`, mas o
//     Laravel importava a trait SoftDeletes e nunca a aplicava: cancelar uma
//     matrícula apagava o cadastro em definitivo. Foi o que causou a perda de
//     dados que o `recovery_customers.json` documenta. Aqui o "apagar" é um
//     carimbo em `arquivadoEm`, e nada some.
//   - `teachers.password` era MD5 sem sal. Professor entra pelo Google ou por
//     convite; não existe mais senha na tabela.
//
// `legacyId` guarda o id que a linha tinha no MySQL. Ele não é usado em
// lugar nenhum da aplicação — existe só para a importação saber o que já
// trouxe e não duplicar se rodar duas vezes.

model Unidade {
  id         String  @id @default(uuid())
  legacyId   Int?    @unique
  nome       String
  descricao  String?
  endereco   String?
  // Foto da unidade na página de entrada. `ativa = false` já a tira de lá
  // (mesma regra do resto do sistema) — não existe uma segunda chave "mostrar
  // no site": uma unidade fechada não deveria aparecer em lugar nenhum.
  fotoBase64 String?
  ativa      Boolean @default(true)

  turmas     Turma[]
  matriculas Matricula[]

  folhaGrade    GradeHorariaFolha[]
  folhaFeriados FeriadoFolha[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("unidades")
  @@schema("hub")
}

enum DiaDaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO

  @@schema("hub")
}

model Turma {
  id                    String  @id @default(uuid())
  legacyId              Int?    @unique
  nome                  String
  categoria             String?
  descricao             String?
  link                  String?
  // Capacidade da turma. Era `text` no original, o que impedia qualquer conta
  // de ocupação sem conversão no meio do caminho.
  capacidade            Int?
  ativa                 Boolean @default(true)
  // Se aceita matrícula nova pelo site. No original: is_enabled_new_courses.
  aceitaNovasMatriculas Boolean @default(true)

  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  horarios    HorarioTurma[]
  professores ProfessorTurma[]
  planos      PlanoTurma[]
  matriculas  Matricula[]
  presencas   Presenca[]
  ocorrencias Ocorrencia[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([unidadeId, ativa])
  @@map("turmas")
  @@schema("hub")
}

// Um horário por dia da semana. No original, `day`, `starts_at` e `ends_at`
// eram strings livres — dava para gravar "segunda", "Segunda" e "seg" na mesma
// coluna, e nenhuma consulta conseguia agrupar por dia.
model HorarioTurma {
  id      String      @id @default(uuid())
  turmaId String
  turma   Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  dia     DiaDaSemana
  // "18:00" — hora local da escola, sem fuso: é horário de parede, não instante.
  inicio  String
  fim     String

  criadoEm DateTime @default(now())

  @@index([turmaId])
  @@map("horarios_turma")
  @@schema("hub")
}

model Professor {
  id       String  @id @default(uuid())
  legacyId Int?    @unique
  nome     String
  // A tabela original não tinha e-mail nem CPF, só `username` e uma senha MD5.
  // É por isso que professor não consegue se vincular sozinho por CPF e entra
  // por convite. Com e-mail aqui, o convite passa a ser opcional.
  email    String? @unique
  telefone String?
  ativo    Boolean @default(true)

  turmas      ProfessorTurma[]
  presencas   Presenca[]
  ocorrencias Ocorrencia[]
  vinculo     Vinculo?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("professores")
  @@schema("hub")
}

model ProfessorTurma {
  professorId String
  turmaId     String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  turma       Turma     @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@id([professorId, turmaId])
  @@map("professor_turma")
  @@schema("hub")
}

model Plano {
  id                  String  @id @default(uuid())
  legacyId            Int?    @unique
  nome                String
  descricao           String?
  valor               Decimal @db.Decimal(10, 2)
  parcelas            Int     @default(1)
  ativo               Boolean @default(true)
  // Permite mais de uma matrícula no mesmo plano (plano família).
  multiplasMatriculas Boolean @default(false)
  descontoPercentual  Int     @default(0)
  descontoAteDias     Int     @default(0)

  turmas     PlanoTurma[]
  matriculas Matricula[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("planos")
  @@schema("hub")
}

model PlanoTurma {
  planoId String
  turmaId String
  plano   Plano  @relation(fields: [planoId], references: [id], onDelete: Cascade)
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@id([planoId, turmaId])
  @@map("plano_turma")
  @@schema("hub")
}

// O responsável financeiro — `customers` no original.
model Responsavel {
  id       String  @id @default(uuid())
  legacyId Int?    @unique
  nome     String
  email    String?
  telefone String?
  cpf      String  @unique

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  asaasCustomer String?

  alunos     Aluno[]
  matriculas Matricula[]
  vinculo    Vinculo?

  // Nada é apagado: "excluir" carimba aqui. Ver o comentário no topo do bloco.
  arquivadoEm  DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@index([nome])
  @@map("responsaveis")
  @@schema("hub")
}

model Aluno {
  id            String    @id @default(uuid())
  legacyId      Int?      @unique
  nome          String
  // A foto vive no banco, como data URL, e não num diretório.
  //
  // O sistema atual grava o arquivo em storage/photo e guarda o caminho. No
  // Render isso perderia as fotos a cada deploy: o disco é efêmero, e o
  // arquivo some enquanto a linha do aluno continua apontando para ele.
  //
  // São duas: a miniatura acompanha as listas (chamada, cadastro), e a
  // grande abre só quando alguém pede. Sem essa separação, uma lista de
  // cinquenta alunos arrastaria mais de um megabyte para desenhar rostos de
  // 40 pixels — foi o mesmo cuidado que a arte do cronograma exigiu.
  foto          String? // ~400px, aberta sob demanda
  fotoMiniatura String? // ~96px, viaja nas listas
  nascimento    DateTime? @db.Date
  observacao    String?

  responsavelId String?
  responsavel   Responsavel? @relation(fields: [responsavelId], references: [id])

  matriculas Matricula[]
  presencas  Presenca[]

  arquivadoEm  DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@index([nome])
  @@index([responsavelId])
  @@map("alunos")
  @@schema("hub")
}

enum StatusMatricula {
  CRIADA
  PAGAMENTO_PENDENTE
  CONFIRMADA
  CANCELADA

  @@schema("hub")
}

model Matricula {
  id       String          @id @default(uuid())
  legacyId Int?            @unique
  status   StatusMatricula @default(CRIADA)

  alunoId       String
  aluno         Aluno       @relation(fields: [alunoId], references: [id])
  responsavelId String
  responsavel   Responsavel @relation(fields: [responsavelId], references: [id])
  turmaId       String
  turma         Turma       @relation(fields: [turmaId], references: [id])
  unidadeId     String
  unidade       Unidade     @relation(fields: [unidadeId], references: [id])
  planoId       String
  plano         Plano       @relation(fields: [planoId], references: [id])

  observacao String?
  expiraEm   DateTime? @db.Date

  // Matrícula principal do responsável, ou vinculada a ela.
  //
  // É o plano família: um responsável paga por dois ou três filhos, e uma das
  // matrículas carrega a cobrança enquanto as outras acompanham. No sistema
  // antigo isso era gravado na coluna `category` da matrícula, com os valores
  // 'parent' e 'child' — a mesma coluna que em `courses` guarda Kids/Teens/
  // Adulto. Duas coisas sem relação no mesmo nome.
  //
  // Não impedimos duas principais no mesmo responsável: uma família com
  // filhos em unidades diferentes pode ter dois planos família de verdade. A
  // tela mostra quais são, e o administrativo decide.
  principal Boolean @default(true)

  // Cobrança. `asaasPayload` guarda a resposta crua da criação, que é o que
  // permite reconstruir o que foi enviado quando uma cobrança diverge.
  asaasReferencia String?
  asaasPagamento  String?
  linkPagamento   String?
  asaasPayload    Json?

  canceladaEm  DateTime?
  arquivadoEm  DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@index([status, criadoEm])
  @@index([turmaId, status])
  @@index([alunoId])
  @@map("matriculas")
  @@schema("hub")
}

// Uma linha por aluno por chamada. O original gravava `has_presence` false
// para o ausente, mas a API só marcava presença quando a chave existia no
// corpo — e é por isso que faltar e não ser citado viravam a mesma coisa.
// Aqui presente é um booleano gravado sempre, e a ausência é um registro.
model Presenca {
  id String @id @default(uuid())

  turmaId     String
  turma       Turma     @relation(fields: [turmaId], references: [id])
  alunoId     String
  aluno       Aluno     @relation(fields: [alunoId], references: [id])
  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])

  data     DateTime @db.Date
  presente Boolean

  criadoEm DateTime @default(now())

  // Uma chamada por aluno por turma por dia. O Laravel garantia isso com uma
  // consulta antes de inserir, o que deixava a porta aberta para duas
  // chamadas simultâneas. Aqui é o banco que garante.
  @@unique([turmaId, alunoId, data])
  @@index([turmaId, data])
  @@index([alunoId, data])
  @@map("presencas")
  @@schema("hub")
}

// ---------------------------------------------------------------------------
// Sociedade
//
// É só o registro de quem é sócio e de quanto tem. O repasse do dinheiro NÃO
// vive aqui: ele é feito fora do sistema, e trazê-lo para cá seria manter um
// segundo livro-caixa em paralelo ao que já existe.
// ---------------------------------------------------------------------------

model Socio {
  id   String @id @default(uuid())
  nome String

  // Em pontos percentuais: 33.34 é um terço. A soma dos sócios ativos deveria
  // dar 100, mas o sistema não impede que não dê — durante uma entrada ou uma
  // saída ela fica quebrada por alguns dias, e travar isso obrigaria a
  // secretaria a inventar um número só para o formulário fechar. A tela avisa.
  participacao Decimal @db.Decimal(6, 3)

  email    String?
  telefone String?
  entrouEm DateTime? @db.Date

  arquivadoEm  DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@map("socios")
  @@schema("hub")
}

// ---------------------------------------------------------------------------
// Fechamento do dia
//
// Uma linha por dia, gravada às 23:59, com o retrato da escola naquele
// instante. Existe porque a série do painel era RECONSTRUÍDA das datas de cada
// matrícula, e reconstrução tem dois furos que nenhum código conserta: ela usa
// o preço de hoje para meses passados, e `status` não guarda histórico.
//
// A partir do primeiro fechamento gravado, o número do dia é o que ele era no
// dia — não o que a base de hoje sugere que ele tenha sido.
//
// A linha é idempotente pela data: rodar duas vezes no mesmo dia corrige, não
// duplica. É o que permite reprocessar um dia que falhou sem medo.
// ---------------------------------------------------------------------------

model FechamentoDiario {
  id   String   @id @default(uuid())
  data DateTime @unique @db.Date

  ativos   Int
  entradas Int
  saidas   Int

  receitaPrevista Decimal @db.Decimal(12, 2)
  vagasOciosas    Int

  // Como a linha nasceu: AUTOMATICO no horário, MANUAL quando alguém mandou
  // reprocessar, RECONSTRUIDO quando o sistema preencheu um dia que passou sem
  // fechamento. O terceiro carrega a ressalva da reconstrução e a tela precisa
  // saber disso para não apresentar os três com a mesma cara de exato.
  origem String @default("AUTOMATICO")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([data])
  @@map("fechamentos_diarios")
  @@schema("hub")
}

// ---------------------------------------------------------------------------
// Galeria da página de entrada — fotos subidas à mão pela equipe.
//
// Existe uma integração de verdade com o Instagram agora (ver InstagramPost,
// mais abaixo): quando ela está configurada e funcionando, é ela que aparece
// em "Siga-nos". Esta tabela continua existindo como o que a página mostra
// quando a integração não está configurada, ou quando o token expirou e
// ainda não foi renovado — reserva, não a fonte principal. Mesmo padrão de
// imagem (data URL, comprimida no navegador antes de enviar) — ver
// conteudo.routes.ts.
// ---------------------------------------------------------------------------

model GaleriaFoto {
  id            String   @id @default(uuid())
  imagemBase64  String
  imagemNome    String?
  legenda       String?
  // Link para o post de verdade no Instagram, se quiser — opcional: a foto
  // aparece na página de entrada com ou sem ele.
  linkInstagram String?
  ordem         Int      @default(0)
  ativa         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([ativa, ordem])
  @@map("galeria_fotos")
  @@schema("hub")
}

// ---------------------------------------------------------------------------
// Últimos posts do Instagram de verdade, buscados pela Graph API do Meta e
// guardados aqui — a página de entrada lê esta tabela, nunca o Instagram
// direto (evita expor o token e evita a página travar se o Instagram estiver
// fora do ar). Um job diário (ver src/modules/publico/instagram.ts) renova o
// token antes que ele expire e busca as fotos mais recentes; o token e o
// resto da configuração ficam em Configuracao, chave a chave, do mesmo jeito
// que taxaMatricula e linkTermos.
// ---------------------------------------------------------------------------

model InstagramPost {
  // O id de mídia do próprio Instagram — reaproveitado como chave primária de
  // propósito: um upsert por id já resolve "postou de novo" sem duplicar.
  id           String    @id
  imagemUrl    String
  legenda      String?
  permalink    String
  publicadoEm  DateTime?
  atualizadoEm DateTime  @updatedAt

  @@index([publicadoEm])
  @@map("instagram_posts")
  @@schema("hub")
}

enum SlotPaginaImagem {
  CARROSSEL
  SOBRE_NOS
  HORARIOS
  VALORES

  @@schema("hub")
}

// ---------------------------------------------------------------------------
// Imagens de conteúdo fixo da página de entrada — o carrossel do topo, a foto
// de "Sobre nós", e os cartazes de horários e valores que a escola já usa nas
// redes sociais. Só SOBRE_NOS é de propósito uma foto só (mostra a primeira
// ativa, pela `ordem`, e ignora o resto); os outros três slots aceitam
// várias — CARROSSEL e o par HORARIOS/VALORES viram carrossel na página, o
// segundo com setas e pontinhos, porque ali faz sentido passar na mão (uma
// foto por unidade, uma por plano). Mesma tabela para os quatro, pra não
// multiplicar telas de administração quase iguais.
// ---------------------------------------------------------------------------

model PaginaImagem {
  id           String           @id @default(uuid())
  slot         SlotPaginaImagem
  imagemBase64 String
  legenda      String?
  ordem        Int              @default(0)
  ativa        Boolean          @default(true)
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  @@index([slot, ativa, ordem])
  @@map("pagina_imagens")
  @@schema("hub")
}

// ---------------------------------------------------------------------------
// Folha de pagamento — reconstrução nativa de uma plataforma que já existia
// separada (HTML próprio, banco Supabase à parte), trazida pra dentro do Hub
// a pedido de quem usa. Mora na aba dos sócios, não no administrativo: é
// controle de pagamento da equipe, papel de quem responde pela sociedade.
//
// "ColaboradorFolha" é de propósito um cadastro à parte de `Professor`: um é
// quem dá aula (turma, portal do professor, login); o outro é o registro de
// PAGAMENTO daquela pessoa (nível salarial, tipo pra fins de folha, se está
// ativo). Nem todo ColaboradorFolha é um Professor no sentido do Hub (pode
// ser estagiário sem turma própria), e forçar os dois a serem a mesma
// entidade quebraria no primeiro caso que não se encaixasse perfeitamente
// nos dois papéis ao mesmo tempo.
// ---------------------------------------------------------------------------

enum TipoColaboradorFolha {
  PROFESSOR
  ESTAGIARIO

  @@schema("hub")
}

enum CategoriaFolha {
  PROFESSOR
  ESTAGIARIO
  AVULSO // não entra nas tabelas da Folha de Pagamento

  @@schema("hub")
}

model ColaboradorFolha {
  id   String @id @default(uuid())
  nome String

  // Texto livre, só pra exibição na lista — "Cabo Branco / Bessa" quando dá
  // aula em mais de uma. A unidade que importa pra cálculo é a de cada linha
  // da Grade Horária (essa sim ligada à Unidade de verdade do Hub).
  unidadeTexto String @default("")

  tipo  TipoColaboradorFolha
  nivel Int                  @default(1)

  // Ausente = usa o `tipo` pra decidir em qual tabela da Folha ele aparece.
  // Existe pra quem é, por exemplo, estagiário mas pago como horista de
  // professor — o valor da hora continua vindo do `tipo`.
  categoriaFolha CategoriaFolha?

  ativo            Boolean   @default(true)
  dataDesligamento DateTime? @db.Date

  criadoEm DateTime @default(now())

  grade       GradeHorariaFolha[]
  lancamentos LancamentoFolha[]
  ferias      FeriasFolha[]
  overrides   FolhaOverride[]

  @@map("folha_colaboradores")
  @@schema("hub")
}

enum CodigoDiasFolha {
  TQ // Terça, Quinta
  SQS // Segunda, Quarta, Sexta
  SQ // Segunda, Quarta
  QS // Quarta, Sexta
  SEX // Sexta
  SAB // Sábado

  @@schema("hub")
}

// Uma linha por turma que o colaborador dá. A Folha conta quantas vezes o
// código de dias cai no mês (por isso não existe "dias letivos" digitado à
// mão) e multiplica pela duração. `dataInicio`/`dataFim` marcam vigência:
// sem elas, vale desde sempre — com elas, só os meses dentro do intervalo
// contam essa linha, pra um professor que assume ou larga uma turma no meio
// do caminho não recalcular os meses de antes ou de depois errado.
model GradeHorariaFolha {
  id            String               @id @default(uuid())
  colaboradorId String
  colaborador   ColaboradorFolha     @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  unidadeId     String
  unidade       Unidade              @relation(fields: [unidadeId], references: [id])
  turma         String
  codigo        CodigoDiasFolha
  horario       String               @default("")
  duracaoHoras  Decimal              @db.Decimal(4, 2)
  tipo          TipoColaboradorFolha
  nivel         Int                  @default(1)
  // Esse dia conta pro VT antecipado do mês seguinte? Desmarcado quando a
  // turma não gera direito a vale-transporte (ex.: aula muito curta).
  semVt         Boolean              @default(false)
  nota          String?
  dataInicio    DateTime?            @db.Date
  dataFim       DateTime?            @db.Date

  @@index([colaboradorId])
  @@map("folha_grade_horaria")
  @@schema("hub")
}

// Uma linha por tipo+nível — a tabela de referência que todo o resto usa
// pra transformar hora/dia em R$. Editável pela tela; muda o valor daqui e
// todo lançamento e toda folha recalculam sozinhos, porque nada guarda o
// valor em R$ no momento do lançamento, só a quantidade (horas, dias) — o
// preço é sempre lido daqui, na hora de mostrar.
model ValorFolha {
  id        String               @id @default(uuid())
  tipo      TipoColaboradorFolha
  nivel     Int
  valorHora Decimal              @db.Decimal(8, 2)
  valorVt   Decimal              @db.Decimal(8, 2)

  @@unique([tipo, nivel])
  @@map("folha_valores")
  @@schema("hub")
}

enum TipoLancamentoFolha {
  EXTRA
  AUSENCIA
  AUSENCIA_ATESTADO
  BONUS
  COMPETICAO
  COMPETICAO_PSICOLOGA
  DESCONTO_VT
  BANCO_HORAS_COMPENSADO

  @@schema("hub")
}

// O lançamento em si — cada linha é um evento (uma falta, uma hora extra,
// um bônus...) num dia específico. O valor em R$ NUNCA é gravado aqui: é
// sempre calculado na hora, cruzando `horas`/tipo/nível com ValorFolha —
// ver a função calcularLancamento() nas rotas. Mesma regra do sistema
// original: mudar um valor na tabela de referência recalcula tudo pra trás.
model LancamentoFolha {
  id            String              @id @default(uuid())
  data          DateTime            @db.Date
  colaboradorId String
  colaborador   ColaboradorFolha    @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo          TipoLancamentoFolha
  nivel         Int                 @default(1)
  // Para a maioria dos tipos, quantidade de horas. Para "Desconto VT",
  // quantidade de DIAS de VT a descontar (multiplicado pelo valorVt).
  horas         Decimal             @default(0) @db.Decimal(6, 2)
  usaVt         Boolean             @default(true)
  motivo        String?
  criadoEm      DateTime            @default(now())

  @@index([colaboradorId, data])
  @@map("folha_lancamentos")
  @@schema("hub")
}

model FeriasFolha {
  id            String           @id @default(uuid())
  colaboradorId String
  colaborador   ColaboradorFolha @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  dataInicio    DateTime         @db.Date
  dataFim       DateTime         @db.Date
  observacao    String?

  @@map("folha_ferias")
  @@schema("hub")
}

// "Todas" (unidadeId nulo) ou uma unidade específica — feriado municipal só
// afeta a unidade daquele município, por exemplo.
model FeriadoFolha {
  id              String   @id @default(uuid())
  data            DateTime @db.Date
  unidadeId       String?
  unidade         Unidade? @relation(fields: [unidadeId], references: [id])
  descricao       String?
  contaTrabalhado Boolean  @default(false)

  @@map("folha_feriados")
  @@schema("hub")
}

// Correção manual de um valor calculado da Folha de Pagamento — existe, se
// existir, do jeito que ele foi corrigido. `folhaOverrideReset` na tela
// simplesmente apaga a linha, e o cálculo automático volta a valer.
model FolhaOverride {
  mes           String // "AAAA-MM"
  colaboradorId String
  colaborador   ColaboradorFolha @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  campo         String // "bolsa" | "complementar" | "vt" | "hn1" | "hn2" | "dias" | "diariaBonus"
  valor         Decimal          @db.Decimal(10, 2)

  @@id([mes, colaboradorId, campo])
  @@map("folha_overrides")
  @@schema("hub")
}
