# ---------------------------------------------------------------------------
# SE7 Hub — variaveis de ambiente
#
# Nenhuma variavel deste arquivo aponta para o sistema Laravel em modo escrita.
# O Laravel continua rodando exatamente como esta; o Hub so LE dele.
# ---------------------------------------------------------------------------

# Postgres proprio do Hub (Supabase).
# DATABASE_URL usa o pooler de transacao (porta 6543) — e o que a aplicacao usa.
# DIRECT_URL e a conexao direta (5432), usada so por `prisma db push`/migrate.
DATABASE_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Opcional: só para rodar mudança de schema pela CLI do Prisma. Em produção o
# app não precisa dela — as tabelas vêm de prisma/instalar-no-supabase.sql.
DIRECT_URL=""

# Minimo 32 caracteres. Em producao, deixe o Render gerar (render.yaml).
JWT_SECRET=""

PORT=3400

# Google Cloud > APIs e servicos > Credenciais > ID do cliente OAuth 2.0,
# tipo "Aplicativo da Web". O mesmo ID serve para o site e para o app dos
# professores. O servidor so valida o id_token — nao existe client secret aqui.
GOOGLE_CLIENT_ID=""

# MySQL do sistema Laravel, SOMENTE LEITURA.
# Crie um usuario dedicado com GRANT SELECT apenas:
#   CREATE USER 'se7hub_ro'@'%' IDENTIFIED BY '...';
#   GRANT SELECT ON nome_do_banco.* TO 'se7hub_ro'@'%';
# Deixe em branco enquanto o acesso nao estiver liberado: o Hub sobe assim
# mesmo e as rotas que dependem do legado respondem 503 com mensagem clara.
LEGACY_MYSQL_HOST=""
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=""
LEGACY_MYSQL_PASSWORD=""
LEGACY_MYSQL_DATABASE=""

# Contas que viram ADMIN no primeiro login com Google. Sem pelo menos uma,
# nao existe quem emita o primeiro convite. Separe por virgula.
ADMIN_EMAILS=""

# Valvula de escape: se definida, o seed cria tambem login por senha (bcrypt)
# para as contas de ADMIN_EMAILS. Deixe vazia para permitir so o Google.
SEED_ADMIN_SENHA=""

# Quantas tentativas de vinculo com CPF errado uma conta pode fazer por hora.
VINCULO_MAX_TENTATIVAS_HORA=5

# Asaas — leitura das faturas do portal do responsavel.
# Use a chave de producao so em producao; a de sandbox tem outra base_url.
# A verificacao de certificado TLS fica LIGADA (ver src/services/asaas).
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://api.asaas.com/v3"
ASAAS_TIMEOUT_MS=8000
