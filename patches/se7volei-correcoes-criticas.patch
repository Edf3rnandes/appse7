diff --git a/app/Services/Asaas/AsaasClient.php b/app/Services/Asaas/AsaasClient.php
new file mode 100644
index 0000000..4706ada
--- /dev/null
+++ b/app/Services/Asaas/AsaasClient.php
@@ -0,0 +1,35 @@
+<?php
+
+namespace App\Services\Asaas;
+
+use Illuminate\Http\Client\PendingRequest;
+use Illuminate\Support\Facades\Http;
+
+/**
+ * Ponto único de saída para a API do Asaas.
+ *
+ * Existe por dois motivos:
+ *
+ * 1. A verificação de certificado TLS fica LIGADA. Antes, cada chamada trazia
+ *    o seu próprio ->withoutVerifying(), o que desativava a validação do
+ *    certificado enquanto a chave de produção viajava no header — 17 chamadas
+ *    espalhadas por cinco arquivos, todas expostas a interceptação.
+ *
+ * 2. Timeout. Sem ele, uma indisponibilidade do Asaas segura a requisição do
+ *    usuário até o limite do PHP.
+ *
+ * Não há retry aqui de propósito: repetir um POST /payments criaria cobrança
+ * duplicada. Quem precisar de nova tentativa decide caso a caso.
+ */
+class AsaasClient
+{
+    public static function http(): PendingRequest
+    {
+        return Http::withHeaders([
+            'access_token' => config('asaas.api_key'),
+        ])
+            ->baseUrl((string) config('asaas.base_url'))
+            ->timeout((int) config('asaas.timeout'))
+            ->acceptJson();
+    }
+}
