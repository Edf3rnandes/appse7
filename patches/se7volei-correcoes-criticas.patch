 use App\Http\Controllers\Controller;
 use App\Models\Teacher;
+use Illuminate\Http\JsonResponse;
 use Illuminate\Http\Request;
-use Illuminate\Support\Str;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Log;
 
 class LoginApiController extends Controller
 {
-    public function login(Request $request)
+    public function login(Request $request): JsonResponse
     {
-        if (!$request->username) {
-            return response()->json([
-                'error' => [
-                    'message' => 'username Obrigatório'
-                ]
-            ], 400);
+        $username = (string) $request->input('username', '');
+        $password = (string) $request->input('password', '');
+
+        if ($username === '') {
+            return $this->erro('Usuário obrigatório');
+        }
+
+        // Senha em branco chegava aqui como null e virava md5(''), que era
+        // exatamente o valor gravado no banco a cada edição de professor —
+        // qualquer conta editada passava a entrar com o campo vazio.
+        if ($password === '') {
+            return $this->erro('Senha obrigatória');
         }
 
-        $teacher = Teacher::where('username', $request->username)
+        $teacher = Teacher::where('username', $username)
             ->where('active', true)
             ->first();
 
-        if (!$teacher) {
-            return response()->json([
-                'error' => [
-                    'message' => 'Professor não localizado'
-                ]
-            ], 400);
+        if (! $teacher) {
+            return $this->erro('Professor não localizado');
         }
 
-        if (md5($request->password) == $teacher->password) {
-            return response()->json([
-                'login' => true,
-                'name' => $teacher->name,
-                'secret' => $teacher->secret
-            ]);
+        if (! $this->senhaConfere($password, $teacher)) {
+            return $this->erro('Erro ao tentar realizar login');
         }
 
+        $this->migrarSenhaSePreciso($password, $teacher);
+
         return response()->json([
-            'error' => [
-                'message' => 'Erro ao tentar realizar login'
-            ]
-        ], 400);
+            'login' => true,
+            'name' => $teacher->name,
+            'secret' => $teacher->secret,
+        ]);
+    }
+
+    /**
+     * Aceita os dois formatos durante a transição: o MD5 antigo e o bcrypt novo.
+     *
+     * A comparação do MD5 usa hash_equals em vez de ==, que fazia comparação
+     * numérica quando os dois hashes começavam com "0e".
+     */
+    private function senhaConfere(string $password, Teacher $teacher): bool
+    {
+        $armazenada = (string) $teacher->password;
+
+        if ($armazenada === '') {
+            return false;
+        }
+
+        if ($this->pareceMd5($armazenada)) {
+            // Conta cuja senha foi apagada pelo bug do TeacherController:
+            // nenhuma senha entra nela até a secretaria cadastrar uma nova.
+            if (hash_equals(strtolower($armazenada), md5(''))) {
+                Log::warning('LOGIN_PROFESSOR: senha em branco no banco, acesso bloqueado.', [
+                    'teacher_id' => $teacher->id,
+                ]);
+
+                return false;
+            }
+
+            return hash_equals(strtolower($armazenada), md5($password));
+        }
+
+        return Hash::check($password, $armazenada);
+    }
+
+    /**
+     * Regrava em bcrypt no primeiro login bem-sucedido de quem ainda está em
+     * MD5. Assim a base migra sozinha, sem pedir troca de senha a ninguém.
+     */
+    private function migrarSenhaSePreciso(string $password, Teacher $teacher): void
+    {
+        if (! $this->pareceMd5((string) $teacher->password)) {
+            return;
+        }
+
+        $teacher->password = Hash::make($password);
+        $teacher->save();
+
+        Log::info('LOGIN_PROFESSOR: senha migrada de MD5 para bcrypt.', [
+            'teacher_id' => $teacher->id,
+        ]);
+    }
+
+    private function pareceMd5(string $valor): bool
+    {
+        return (bool) preg_match('/^[a-f0-9]{32}$/i', $valor);
+    }
+
+    private function erro(string $mensagem): JsonResponse
+    {
+        return response()->json(['error' => ['message' => $mensagem]], 400);
     }
 }
