+  'api_key' => $producao ? env('ASAAS_API_KEY') : env('ASAAS_SANDBOX_API_KEY'),
+  'base_url' => $producao ? env('ASAAS_BASE_URL') : env('ASAAS_SANDBOX_BASE_URL'),
+
+  // Token que o Asaas envia no header `asaas-access-token` de cada webhook.
+  // Configure o mesmo valor no painel do Asaas, em Integrações > Webhooks.
+  // Sem ele, a rota de webhook responde 503 e recusa tudo — falhar fechado é
+  // proposital: melhor não processar do que processar de qualquer origem.
+  'webhook_token' => env('ASAAS_WEBHOOK_TOKEN'),
+
+  // Segundos até desistir de uma chamada ao Asaas.
+  'timeout' => env('ASAAS_TIMEOUT', 15),
+
+  'enrollment_value' => env('PLAN_BASE_AMOUNT', 99.90),
+  'plan_discount' => env('PLAN_DEFAULT_DISCOUNT'),
+  'plan_discount_days' => env('PLAN_DISCOUNT_DAYS'),
+];
