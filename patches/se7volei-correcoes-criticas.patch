@@ -0,0 +1,42 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Autentica o webhook do Asaas.
+ *
+ * A rota /webhook/asaas ficava aberta na internet e sem nenhuma verificação:
+ * um POST com {"payment":{"status":"RECEIVED","pixQrCodeId":"..."}} confirmava
+ * matrícula sem pagamento algum. O Asaas envia um token próprio no header
+ * `asaas-access-token` justamente para isso.
+ *
+ * A comparação usa hash_equals para não vazar o token por tempo de resposta.
+ */
+class VerifyAsaasWebhook
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $esperado = (string) config('asaas.webhook_token');
+
+        if ($esperado === '') {
+            Log::error('WEBHOOK_ASAAS: ASAAS_WEBHOOK_TOKEN não configurado — requisição recusada.');
+
+            return response()->json(['message' => 'Webhook não configurado.'], 503);
+        }
+
+        $recebido = (string) $request->header('asaas-access-token', '');
+
+        if ($recebido === '' || ! hash_equals($esperado, $recebido)) {
+            Log::warning('WEBHOOK_ASAAS: token inválido.', ['ip' => $request->ip()]);
+
+            return response()->json(['message' => 'Não autorizado.'], 401);
+        }
+
+        return $next($request);
+    }
+}
