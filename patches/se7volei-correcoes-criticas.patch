+/*
+|---------------------------------------------------------------------------
+| Nenhuma rota daqui tinha autenticação, fora o login. Foram separadas em três
+| grupos conforme quem realmente consome cada uma:
+|
+|   1. App dos professores  -> exige o `secret` do login ('teachers.api')
+|   2. Site de matrícula    -> segue público, é catálogo, mas com limite
+|   3. Portal do responsável-> segue público por ora (o app da família ainda
+|      não tem login); limite apertado para conter varredura de CPF. O
+|      fechamento de verdade é o SE7 Hub, onde o acesso passa a exigir conta.
+|---------------------------------------------------------------------------
+*/
+
+// Login do app dos professores. throttle apertado: é a porta de força bruta.
+Route::post('/auth/login/teachers', [LoginApiController::class, 'login'])
+    ->middleware('throttle:5,1');
+
+// --- 1. App dos professores -------------------------------------------------
+Route::middleware('teachers.api')->group(function () {
+    Route::post('/attendances', [AttendanceController::class, 'store']);
+    Route::get('/courses/{id}/students', [CourseController::class, 'students']);
+    Route::post('/upload-foto', [EnrollmentController::class, 'upload']);
+});
+
+// --- 2. Site de matrícula (catálogo público) --------------------------------
+Route::middleware('throttle:60,1')->group(function () {
+    Route::get('/units', [UnitController::class, 'index']);
+    Route::get('/plans', [PlanController::class, 'index']);
+    Route::get('/courses', [CourseController::class, 'index']);
+});
+
+Route::post('/enrollment', [EnrollmentController::class, 'store'])
+    ->middleware('throttle:5,1');
+
+// --- 3. Portal do responsável ----------------------------------------------
+Route::middleware('throttle:10,1')->group(function () {
+    Route::get('/customer/bills', [CustomerApiController::class, 'bills']);
+    Route::get('/get-address-customer', [CustomerApiController::class, 'getAddress']);
+    Route::put('/update-address-customer', [CustomerApiController::class, 'updateAddress']);
+});
