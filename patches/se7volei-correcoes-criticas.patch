 namespace App\Http\Middleware;
 
+use App\Models\Teacher;
 use Closure;
 use Illuminate\Http\Request;
 use Symfony\Component\HttpFoundation\Response;
 
+/**
+ * Valida o `secret` devolvido no login do app dos professores.
+ *
+ * Este middleware existia como um `return $next($request)` vazio e nem estava
+ * registrado — na prática as rotas do app ficavam abertas, e
+ * /api/courses/{id}/students devolvia nome e foto de aluno para qualquer um.
+ *
+ * O token é aceito de onde o app já o envia hoje (parâmetros `token` e
+ * `teacher`) e também por header, que é para onde ele deve migrar — em query
+ * string ele acaba gravado em log de servidor e histórico de proxy.
+ */
 class TeachersApiMiddleware
 {
-    /**
-     * Handle an incoming request.
-     *
-     * @param  \Closure(\Illuminate\Http\Request): (\Symfony\Component\HttpFoundation\Response)  $next
-     */
     public function handle(Request $request, Closure $next): Response
     {
+        $secret = $this->extrairToken($request);
+
+        if ($secret === '') {
+            return response()->json(['error' => ['message' => 'Token não informado.']], 401);
+        }
+
+        $teacher = Teacher::where('secret', $secret)
+            ->where('active', true)
+            ->first();
+
+        if (! $teacher) {
+            return response()->json(['error' => ['message' => 'Token inválido.']], 401);
+        }
+
+        // Os controllers pegam o professor daqui em vez de reconsultar pelo
+        // parâmetro da requisição.
+        $request->attributes->set('teacher_model', $teacher);
+
         return $next($request);
     }
+
+    private function extrairToken(Request $request): string
+    {
+        $bearer = (string) $request->bearerToken();
+        if ($bearer !== '') {
+            return $bearer;
+        }
+
+        foreach (['X-Teacher-Token'] as $header) {
+            $valor = (string) $request->header($header, '');
+            if ($valor !== '') {
+                return $valor;
+            }
+        }
+
+        foreach (['token', 'teacher'] as $campo) {
+            $valor = $request->input($campo);
+            if (is_string($valor) && $valor !== '') {
+                return $valor;
+            }
+        }
+
+        return '';
+    }
 }
